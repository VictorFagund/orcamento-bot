# Copie este arquivo para .env e preencha

# ---------- IA (transcrição de áudio + interpretação) ----------
# Qualquer provedor compatível com a API da OpenAI. Escolha UMA das opções:

# Opção A - GRATUITA para testar: Groq (crie a chave em console.groq.com/keys)
# Confira os nomes de modelos disponíveis no console da Groq, eles mudam com o tempo.
# IA_API_KEY=
# IA_BASE_URL=https://api.groq.com/openai/v1
# MODELO_AUDIO=whisper-large-v3-turbo
# (llama-3.3-70b-versatile saiu do plano gratuito em 16/08/2026; gpt-oss-120b aceita JSON estrito)
# MODELO_TEXTO=openai/gpt-oss-120b
# IA_MODO_JSON=schema

# Opção B - OpenAI (paga, centavos por orçamento; https://platform.openai.com/api-keys)
IA_API_KEY=
IA_BASE_URL=
MODELO_TEXTO=gpt-4o-mini
MODELO_AUDIO=whisper-1
IA_MODO_JSON=schema

# Token do bot do Telegram (crie conversando com o @BotFather no Telegram)
TELEGRAM_TOKEN=

# Banco: SQLite local por padrão. Em produção, troque por PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/orcamentos
DATABASE_URL=sqlite:///dados/orcamentos.db
PASTA_ARQUIVOS=dados/arquivos

# Lembretes de orçamento sem resposta: 1º após 3 dias, 2º após 7 (só entre 8h e 20h)
FOLLOWUP_DIAS=3,7
HORARIO_LEMBRETES=8-20
FUSO=America/Sao_Paulo

# Lembretes de cobrança (aprovado e ainda não pago): dias após a aprovação
COBRANCA_DIAS=7,15
# Resumo semanal: dia (0 = segunda) e hora
RESUMO_DIA=0
RESUMO_HORA=8
# Teto anual do MEI em reais, para o alerta no resumo (R$ 81 mil em 2026; confira se mudou)
LIMITE_MEI=81000

# Reativação de clientes antigos: no máximo N sugestões por dia
REATIVACOES_POR_DIA=3

# Nome que aparece no rodapé dos PDFs
NOME_PRODUTO=Orçamento Rápido
VALIDADE_DIAS=7
